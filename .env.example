# .env.example - copy ke .env dan isi sesuai VPS/Raspi
# Signaling server di VPS
SIGNALING_URL=ws://VPS_IP:8000/ws
# contoh lokal: ws://localhost:8000/ws
# contoh VPS: ws://65.108.90.12:8000/ws

# ICE
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:VPS_IP:3478
TURN_USERNAME=raspi
TURN_CREDENTIAL=ganti_password_kuat
# alternatif: VPS_HOST dipakai jika TURN_URL kosong tapi butuh TURN
VPS_HOST=VPS_IP

# Peer IDs (harus sama di kedua sisi)
RASPI_PEER_ID=raspi
VPS_PEER_ID=vps

# Kamera USB di Raspi
CAM_DEVICE=0
# atau /dev/video0
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
VIDEO_FPS=20
VIDEO_BITRATE_KBPS=800

# YOLO di VPS
YOLO_MODEL=yolo11s.pt
YOLO_CONF=0.5
# YOLO_CLASSES kosong = semua class, atau "0" untuk person saja, "0,2" untuk person+car
YOLO_CLASSES=
DETECTION_EVERY_N_FRAMES=3
DETECTION_THROTTLE_MS=200
VIEWER_FPS=12
VIEWER_QUALITY=75
BROWSER_VIEWER_ENABLED=1

# FC ArduPilot (Raspi -> FC via USB/UART, configurable)
# Contoh real: /dev/ttyACM0 atau /dev/ttyUSB0 atau serial:///dev/ttyACM0:57600
# Contoh SITL Mission Planner: udp:127.0.0.1:14550 atau udpin:127.0.0.1:14550
FC_CONNECTION_STRING=/dev/ttyACM0
FC_BAUD=57600
TELEMETRY_HZ=10
TELEMETRY_STALE_MS=100
DETECTION_SAVE_DIR=data/detections
DETECTION_SAVE_THROTTLE_MS=1000
GUIDED_ALT_DEFAULT=20
API_KEY=secret
# Optional FC pkg tuning (QuadPlane)
FC_Q_GUIDED_MODE=1
FC_ARRIVAL_RADIUS_M=5.0
FC_ARRIVAL_SPEED_MPS=0.5
FC_GUIDED_TIMEOUT_S=90
